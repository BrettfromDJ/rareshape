# Development only — Next never loads this for a production build.
#
# The three tools under tools/_harness-* are the test fixtures: the export,
# determinism, state and eject checks all render them. They are never listed on
# the index in production, and this keeps them off it locally too.
#
# Set to 1 to see them while working on the platform itself.
NEXT_PUBLIC_SHOW_HARNESS=0
